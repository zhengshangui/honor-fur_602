CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_honor_fur-602=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
# Build + publish the COMPLETE kmod set so extra modules (tc/qdisc/CAKE/IFB,
# netfilter, mac80211/mt76, USB, ...) can be `opkg install`ed later against a
# matching kernel ABI, without adding them to the image.
#
# This is a tristate knob: it flips every kmod package from its default `n` to
# `m` (built + published as .ipk) but does NOT install them into the rootfs --
# only DEFAULT_PACKAGES + DEVICE_PACKAGES are installed. It is deliberately NOT
# CONFIG_ALL=y.
# ========== 基础系统库 ==========
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libjson-c=y
CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_libubox=y
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_libpcap=y
CONFIG_PACKAGE_libxml2=y
CONFIG_PACKAGE_libzstd=y
CONFIG_PACKAGE_liblzma=y
CONFIG_PACKAGE_libbz2=y
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_libpcre2=y
CONFIG_PACKAGE_libreadline=y
CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_kmod-oaf=m
CONFIG_PACKAGE_appfilter=y

# ========== ZeroTier 依赖 ==========
CONFIG_PACKAGE_kmod-tun=m
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_bind-host=y

# ========== 代理插件内核模块（passwall/openclash）【ALL_KMODS=m】 ==========
CONFIG_PACKAGE_kmod-nft-tproxy=m
CONFIG_PACKAGE_kmod-inet-diag=m
CONFIG_PACKAGE_kmod-ipt-nat6=m
CONFIG_PACKAGE_kmod-ipt-ipset=m
CONFIG_PACKAGE_kmod-ipt-conntrack=m
CONFIG_PACKAGE_kmod-ipt-filter=m
CONFIG_PACKAGE_kmod-nft-core=m
CONFIG_PACKAGE_kmod-nft-nat=m

# ========== 网络工具依赖 ==========
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

# ========== SQM QoS依赖【kmod=m，脚本内置】 ==========
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-ifb=m
CONFIG_PACKAGE_kmod-sched-cake=m
CONFIG_PACKAGE_kmod-sched-bpf=m

# ========== WireGuard 依赖【kmod=m，工具内置】 ==========
CONFIG_PACKAGE_kmod-wireguard=m
CONFIG_PACKAGE_wireguard-tools=y

# ========== 其他工具 & 插件依赖 ==========
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_libnetfilter-queue=y
CONFIG_PACKAGE_libnetfilter-conntrack=y
CONFIG_PACKAGE_libnfnetlink=y
CONFIG_PACKAGE_libnetfilter-log=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_libsodium=y
CONFIG_PACKAGE_libbpf=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libcares=y
CONFIG_PACKAGE_libevent2=y
CONFIG_PACKAGE_libnghttp2=y
CONFIG_PACKAGE_kmod-nft-queue=m
CONFIG_PACKAGE_kmod-ipt-nat=m
CONFIG_PACKAGE_kmod-ipt-raw=m
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_ca-certificates=y
